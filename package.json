{
  "name": "DANA",
  "private": true,
  "version": "1.0.0",
  "description": "سامانه جامع مدیریت دانش، نظام مسائل، درخت دانش و ارزیابی پژوهش (DANA)",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "clean": "rimraf dist release server.cjs server.js",
    "lint": "tsc --noEmit",
    "seed": "tsx scripts/run-seed.ts",
    "build:server": "esbuild server.ts --bundle --platform=node --target=node18 --format=cjs --outfile=dist/server.cjs --external:electron --external:vite --external:esbuild",
    "build:electron": "npm run build && npm run build:server && electron-builder --win",
    "electron:dev": "cross-env NODE_ENV=development electron ."
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "file:./src/db/better-sqlite3-shim",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "d3": "^7.9.0",
    "date-fns-jalali": "^4.4.0-0",
    "docx": "^9.7.2",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "file-saver": "^2.0.5",
    "file-type": "^22.1.1",
    "fuse.js": "^7.5.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.4.0",
    "papaparse": "^5.7.0",
    "react": "^19.0.1",
    "react-date-object": "^2.1.9",
    "react-dom": "^19.0.1",
    "react-element-popper": "^2.1.7",
    "react-hot-toast": "^2.6.1",
    "react-is": "^19.3.0",
    "react-multi-date-picker": "^4.5.2",
    "react-router-dom": "^7.18.4",
    "react-zoom-pan-pinch": "^4.2.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "vazirmatn": "^33.0.3",
    "vite": "^8.3.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/d3": "^7.4.3",
    "@types/express": "^4.17.21",
    "@types/file-saver": "^2.0.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "0.28.2",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@google/genai": false,
    "protobufjs": false,
    "electron-winstaller@5.4.0": true
  },
  "build": {
    "appId": "com.alirezalf.dana",
    "productName": "(DANA)سامانه مدیریت دانش و نظام مسائل دانا",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron-main.cjs",
      "dist/**/*",
      "docs/**/*",
      "public/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "icon.ico",
      "artifactName": "Dana-Setup-${version}.${ext}"
    },
    "nsis": {
      "include": "installer/installer.nsh",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "سامانه DANA",
      "deleteAppDataOnUninstall": false,
      "language": "1065"
    }
  }
}