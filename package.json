{
  "name": "knowledge-management-system",
  "version": "2.0.0",
  "description": "سیستم مدیریت دانش و نظام مسائل",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "postinstall": "rm -rf node_modules/multer/node_modules 2>/dev/null || true",
    "lint": "tsc --noEmit",
    "seed:base": "tsx scripts/seed/baseDefinitions.ts",
    "seed:periods": "tsx scripts/seed/periods.ts",
    "seed:org": "tsx scripts/seed/organization.ts",
    "seed:trees": "tsx scripts/seed/trees.ts",
    "seed:issues": "tsx scripts/seed/issues.ts",
    "seed:gaps": "tsx scripts/seed/gapsAndResearch.ts",
    "seed": "npm run seed:base && npm run seed:periods && npm run seed:org && npm run seed:trees && npm run seed:issues && npm run seed:gaps",
    "create-structure": "powershell -ExecutionPolicy Bypass -File ./scripts/Create-ProjectStructure.ps1"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@tanstack/react-virtual": "^3.14.6",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "d3": "^7.8.5",
    "date-fns-jalali": "^4.4.0-0",
    "docx": "^9.7.1",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "file-saver": "^2.0.5",
    "file-type": "^22.0.2",
    "fuse.js": "^7.0.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "multer": "^2.2.0",
    "papaparse": "^5.4.1",
    "react": "^19.0.1",
    "react-arborist": "^3.0.0",
    "react-date-object": "^2.1.9",
    "react-dom": "^19.0.1",
    "react-element-popper": "^2.1.7",
    "react-hot-toast": "^2.6.0",
    "react-multi-date-picker": "^4.5.2",
    "react-router-dom": "^7.18.1",
    "react-to-print": "^3.3.0",
    "react-zoom-pan-pinch": "^4.0.4",
    "recharts": "^3.10.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sqlite3": "^6.0.1",
    "tailwind-merge": "^3.6.0",
    "vazirmatn": "^33.0.3",
    "vite": "^6.2.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/d3": "^7.4.3",
    "@types/express": "^4.17.21",
    "@types/file-saver": "^2.0.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.5.4",
    "esbuild": "^0.25.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2"
  }
}
